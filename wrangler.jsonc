{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama ini MESTI sama dengan nama Worker di dashboard Cloudflare
  "name": "klc",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/auth", "/callback"]
  }
}
