---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { render } from 'astro:content';
import { site, articlesPage as ap, getArticles, abs, fmtDate, readingMinutes } from '../../lib';

export async function getStaticPaths() {
  const posts = await getArticles();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = abs(`/artikel/${post.id}/`);
const related = (await getArticles()).filter(p => p.id !== post.id)
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category)).slice(0, 3);
const shareText = encodeURIComponent(`${d.title} ${url}`);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': d.category === 'News' ? 'NewsArticle' : 'BlogPosting',
    headline: d.title, description: d.description, datePublished: d.date.toISOString(),
    image: d.cover ? abs(d.cover) : undefined, mainEntityOfPage: url,
    author: { '@type': d.author ? 'Person' : 'Organization', name: d.author || site.companyName },
    publisher: { '@type': 'Organization', name: site.companyName }
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: ap.title, item: abs('/artikel/') },
      { '@type': 'ListItem', position: 3, name: d.title, item: url }
    ]
  }
];
---
<Base title={`${d.title} | ${site.shortName}`} description={d.description} image={d.cover} type="article" jsonLd={jsonLd}>
  <article class="pt-20">
    <header class="bg-brand-blue">
      <div class="max-w-3xl mx-auto px-6 pt-16 pb-12">
        <nav class="text-sm text-gray-300 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-gold">Home</a> <span class="mx-2">/</span>
          <a href="/artikel/" class="hover:text-brand-gold">{ap.title}</a>
        </nav>
        <span data-anim="left" class="inline-block bg-brand-gold text-white text-xs font-bold uppercase tracking-wide px-3 py-1 rounded-full mb-4">{d.category}</span>
        <h1 data-anim="left" style="--d:.08s" class="text-3xl md:text-5xl font-bold text-white leading-tight mb-6">{d.title}</h1>
        <p data-anim="up" style="--d:.16s" class="text-gray-300 text-sm">
          <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
          <span class="mx-2">·</span>{readingMinutes(post.body)} min read
          {d.author && <><span class="mx-2">·</span>{d.author}</>}
        </p>
      </div>
    </header>

    {d.cover && (
      <div class="max-w-4xl mx-auto px-6 -mb-2 mt-10">
        <img data-anim="zoom" src={d.cover} alt={d.coverAlt || d.title} class="w-full rounded-2xl shadow-card aspect-[16/9] object-cover" />
      </div>
    )}

    <div class="max-w-3xl mx-auto px-6 py-12">
      <div class="prose-klc"><Content /></div>

      {d.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-10">
          {d.tags.map(t => <span class="text-xs font-semibold bg-brand-light text-gray-700 px-3 py-1 rounded-full">#{t}</span>)}
        </div>
      )}

      <div class="mt-10 pt-8 border-t border-gray-200 flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold text-gray-700 mr-2">Share:</span>
        <a href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-green-500 text-white flex items-center justify-center" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-blue-700 text-white flex items-center justify-center" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      </div>

      <div data-anim="up" class="mt-12 bg-brand-blue rounded-2xl p-8 text-white">
        <h2 class="text-2xl font-bold mb-2">{ap.ctaTitle}</h2>
        <p class="text-gray-200 mb-6">{ap.ctaText}</p>
        <button type="button" data-open-form class="bg-brand-gold text-white px-7 py-3 rounded-full font-bold hover:opacity-90">{ap.ctaButton} <i class="fas fa-arrow-right ml-2"></i></button>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="w-full max-w-[1400px] mx-auto px-6 pb-24">
      <h2 data-anim="left" class="text-3xl font-bold text-gray-900 mb-8">More to read</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-alt="up">{related.map(p => <ArticleCard post={p} showMeta />)}</div>
    </section>
  )}
</Base>
