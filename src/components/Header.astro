---
import Logo from './Logo.astro';
import { site, socialIcon } from '../lib';
const sp = site.sharePrice;
---
<header class="site-header fixed top-0 w-full bg-white shadow-sm z-50 h-20 flex items-center">
  <div class="w-full max-w-[1400px] mx-auto px-6 flex justify-between items-center gap-4">
    <a href="/" aria-label={site.companyName} class="flex items-center gap-3"><Logo /></a>

    <nav class="hidden lg:flex items-center space-x-8" aria-label="Main">
      {site.nav.map(item => (
        <div class="nav-item relative py-4">
          <a href={item.url} class="nav-link text-[15px] font-medium text-gray-800 hover:text-brand-gold transition-colors">
            {item.label}{item.children?.length > 0 && <i class="fas fa-chevron-down text-xs ml-1"></i>}
          </a>
          {item.children?.length > 0 && (
            <div class="nav-menu absolute left-0 top-full min-w-[220px] bg-white rounded-xl shadow-card py-2 opacity-0 invisible -translate-y-1 transition-all duration-200">
              {item.children.map(ch => (
                <a href={ch.url} class="block px-5 py-2.5 text-sm text-gray-700 hover:bg-brand-light hover:text-brand-gold hover:pl-7 transition-all">{ch.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="hidden lg:flex items-center space-x-6">
      <button type="button" data-open-form class="border border-brand-charcoal text-brand-charcoal px-6 py-2 rounded-md text-[14px] font-semibold hover:bg-brand-charcoal hover:text-white transition-colors">
        {site.headerButton}
      </button>
      {sp.show && (
        <div class="flex flex-col border-l border-gray-200 pl-6">
          <div class="text-[13px] font-bold text-gray-900">
            {sp.label}: {sp.price}
            <span class:list={['ml-1', sp.direction === 'down' ? 'text-red-500' : 'text-green-500']}>{sp.direction === 'down' ? '▼' : '▲'} {sp.change}</span>
          </div>
          <div class="text-[11px] text-gray-500 mt-0.5">{sp.updatedAt}</div>
        </div>
      )}
    </div>

    <button type="button" data-open-menu class="lg:hidden text-gray-800 text-2xl w-11 h-11 rounded-full hover:bg-brand-light" aria-label="Menu" aria-controls="fmenu" aria-expanded="false">
      <i class="fas fa-bars"></i>
    </button>
  </div>
</header>

<!-- Menu skrin penuh (telefon/tablet) -->
<div id="fmenu" class="fmenu lg:hidden" aria-hidden="true">
  <div class="fmenu-in">
    <button type="button" data-close-menu class="fmenu-close" aria-label="Close menu"><i class="fas fa-times"></i></button>
    <nav class="fmenu-nav flex flex-col gap-1" aria-label="Mobile">
      <a href="/" class="fmenu-link"><small>01</small>Home</a>
      {site.nav.map((item, i) => (
        <a href={item.url} class="fmenu-link"><small>{String(i + 2).padStart(2, '0')}</small>{item.label}</a>
      ))}
      <div class="pt-8 flex flex-col gap-4">
        <button type="button" data-open-form class="self-start bg-brand-gold text-white px-7 py-3.5 rounded-full font-bold">{site.headerButton} <i class="fas fa-arrow-right ml-2"></i></button>
        <div class="text-sm text-gray-300 space-y-1">
          {site.contact.phone && <p><i class="fas fa-phone mr-2 text-brand-gold"></i>{site.contact.phone}</p>}
          {site.contact.email && <p class="break-all"><i class="fas fa-envelope mr-2 text-brand-gold"></i>{site.contact.email}</p>}
        </div>
        <div class="flex flex-wrap gap-3">
          {site.socials.filter(s => s.url && s.url !== '#').map(s => {
            const m = socialIcon[s.platform] ?? { icon: 'fas fa-link', bg: '#374151' };
            return <a href={s.url} target="_blank" rel="noopener" aria-label={s.platform} class="w-10 h-10 rounded-full bg-white/10 hover:bg-brand-gold text-white flex items-center justify-center transition-colors"><i class={m.icon}></i></a>;
          })}
        </div>
      </div>
    </nav>
  </div>
</div>
