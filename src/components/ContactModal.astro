---
import { site } from '../lib';
const f = site.form;
const input = 'w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-brand-gold bg-gray-50 focus:bg-white';
---
<div id="contact-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300" role="dialog" aria-modal="true" aria-labelledby="contact-title">
  <div id="modal-content" class="bg-white rounded-2xl w-full max-w-lg shadow-2xl scale-95 transition-transform duration-300 flex flex-col max-h-[90vh]">
    <div class="flex justify-between items-center p-6 border-b border-gray-100">
      <h3 id="contact-title" class="text-2xl font-bold text-brand-blue">{f.title}</h3>
      <button type="button" data-close-form class="text-gray-400 hover:text-red-500 transition-colors" aria-label="Close">
        <i class="fas fa-times text-xl"></i>
      </button>
    </div>
    <div class="p-6 overflow-y-auto">
      <form id="inquiryForm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
          <div><label class="block text-sm font-semibold text-gray-700 mb-1" for="f-first">First Name</label><input id="f-first" type="text" name="firstName" class={input} required /></div>
          <div><label class="block text-sm font-semibold text-gray-700 mb-1" for="f-last">Last Name</label><input id="f-last" type="text" name="lastName" class={input} required /></div>
        </div>
        <div class="mb-4"><label class="block text-sm font-semibold text-gray-700 mb-1" for="f-email">Email Address</label><input id="f-email" type="email" name="email" class={input} required /></div>
        <div class="mb-4"><label class="block text-sm font-semibold text-gray-700 mb-1" for="f-company">Company / Organization</label><input id="f-company" type="text" name="company" class={input} /></div>
        <div class="mb-6"><label class="block text-sm font-semibold text-gray-700 mb-1" for="f-msg">Message</label><textarea id="f-msg" name="message" rows="4" class={`${input} resize-none`} required></textarea></div>
        <input type="hidden" name="page" value="" />
        <button type="submit" id="submitBtn" class="w-full bg-brand-blue text-white py-3.5 rounded-lg font-bold hover:opacity-90 transition-opacity shadow-md text-lg flex items-center justify-center group disabled:opacity-60">
          <span id="btnText">{f.submitLabel}</span>
          <i id="btnIcon" class="fas fa-paper-plane ml-2 group-hover:translate-x-1 transition-transform"></i>
          <i id="btnSpinner" class="fas fa-circle-notch fa-spin ml-3 hidden"></i>
        </button>
        <div id="successMessage" class="hidden mt-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-center font-medium">
          <i class="fas fa-check-circle mr-2"></i> {f.successText}
        </div>
      </form>
    </div>
  </div>
</div>
